from discord.ext import commands

class Cleanup(commands.Cog):
    def __init__(self, bot):
        self.bot = bot

    @commands.command(name="cleanup-bot")
    @commands.has_permissions(administrator=True)
    async def cleanup_bot(self, ctx, limit: int = 500):
        deleted = 0

        async for message in ctx.channel.history(limit=limit):
            # Botun mesajlarını sil
            if message.author == self.bot.user:
                try:
                    await message.delete()
                    deleted += 1
                except:
                    pass
                continue

            # velgrath_ mesajlarını ASLA silme
            if message.author.name.lower() == "velgrath_":
                continue

        await ctx.send(
            f"🧹 {deleted} bot mesajı silindi.",
            delete_after=5
        )

async def setup(bot):
    await bot.add_cog(Cleanup(bot))